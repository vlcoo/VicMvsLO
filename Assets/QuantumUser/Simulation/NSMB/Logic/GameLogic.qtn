#define MaxPlayers 10
#pragma max_players MaxPlayers

global {
	GameRules Rules;	
	GameState GameState;
	int StartFrame;
	int TotalGamesPlayed;
	ushort GameStartFrames;
	ushort PlayerLoadFrames;

	array<PlayerInformation>[MaxPlayers] PlayerInfo;
	byte RealPlayers;
	byte TotalMarios;

	int WinningTeam;
	bool HasWinner;
}

struct PlayerInformation {
	PlayerRef PlayerRef;
	QString<48> Nickname;
	QStringUtf8<48> NicknameColor;
	byte Team;
	byte Character;
	bool Disconnected;
	bool Disqualified;
}

struct GameRules {
	AssetRef<Map> Stage;

	int StarsToWin;
	int CoinsForPowerup;
	int Lives;
	int TimerSeconds;
	bool TeamsEnabled;
	bool CustomPowerupsEnabled;
	bool DrawOnTimeUp;
	int Laps;
	list<MatchConditionerTrigger> Triggers;
	
	bool SNoReserve;
	bool SNoDroppedStars;
	bool SInstantDeath;
	bool SNoDefrost;
	bool SNoCollisions;
	bool SNoIframes;
	bool SHideSeek;
	bool SNoEnemies;
	bool SNoBahs;
	bool SPitWrap;
	bool SAllBricks;
	bool SNoLooping;
	bool SNoCoins;
	bool SNoPowerups;
	bool SShowCoinCount;
	
	int ChanceMushroom;
    int ChanceFireFlower;
    int ChanceIceFlower;
    int ChancePropellerMushroom;
    int ChanceBlueShell;
    int ChanceHammerSuit;
    int ChanceMiniMushroom;
    int ChanceMegaMushroom;
    int ChanceStarman;
    
    bool HStars;
    bool HPlayers;
    bool HHost;
    bool HIceCubes;
    int HTeamTarget;
//    bool HStarCount;
//    bool HLifeCount;
//    bool HLapCount;
//    bool HCoinCount;
//    bool HNicknames;
}

enum GameState : Byte {
    PreGameRoom,
    WaitingForPlayers,
    Starting,
    Playing,
    Ended
}

struct MatchConditionerTrigger {
    TriggerCondition Condition;
    QString<64> ConditionParameter;
    TriggerTarget ConditionTarget;
    TriggerAction Action;
    QString<64> ActionParameter;
    TriggerTarget ActionTarget;
    TriggerConstraint Constraint;
    QString<64> ConstraintParameter;
    TriggerTarget ConstraintTarget;
}

enum TriggerCondition {
    GotStar,
    GotCoin,
    Spawned,
    MatchStarted,
//    GotCheckpoint,
    GotPowerup,
    LostPowerup,
//    HitBlock,
    Stunned,
    Frozen,
//    Thawed,
//    StunnedSomeone,
//    SteppedOnEnemy,
//    TriggeredPowerup,
    Died,
    Jumped,
//    LookedXDirection,   // any, up, right, down, left
//    Ran,
    ReachedCoinLimit,
    Disqualified,
//    XSecondRemaining,   // 60, 10
//    EveryXSecond, // 1, 5, 10, 15, 30, 60
//    SongBahd,
    ReachedZeroCoins,
    ReachedZeroStars,
//    GotStarcoin,
//    EnteredPipe,
//    GrabbedSomething,
    FinishedLap,
//    TouchedGround,
//    StoppedMoving,
//    KilledSomeone,
//    HarmedSomeone,
}

enum TriggerAction {
    GiveStar,
    GiveCoin,
    Kill,
    RemoveStar,
    RemoveCoin,
    GiveXPowerup,   // random, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
//    GiveLife,
    Win,
    DrawMatch,
    Disqualify,
    Stun,    // bump, knockback, hardknockback
//    Dive,
//    Launch,
    Freeze,
    Harm,
    SpawnXPowerup,   // random, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
//    SpawnXEnemy,    // random, goomba, Gkoopa, Rkoopa, Bkoopa, bulletbill, boo, spiny, bobomb
    RespawnLevel,
//    ExplodeLevel,
//    RandomTeleport,
    RemoveReserve,
    GiveXReserve,   // random, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
    GiveIFrames,
    SpawnLooseCoin,
    SpawnLooseStar,
    ZeroCoins,
    ZeroStars,
    MaxCoins,
//    SpawnStar,
//    BecomeXTeam,    // random, A, B, C, D, E
}

enum TriggerConstraint {
    Always,
    IsMoving,
    IsStationary,
    IsAirborne,
    IsGrounded,
    IsXPowerup,   // small, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
    IsNotXPowerup,   // small, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
    IsFrozen,
    IsNotFrozen,
    IsUnderwater,
    IsNotUnderwater,
    HasXCoins,  // any X in valid range vvv
    HasXStars,
    HasXLives,
    HasLessThanXCoins,
    HasLessThanXStars,
    HasLessThanXLives,
    HasMoreThanXCoins,
    HasMoreThanXStars,
    HasMoreThanXLives,
    TimerIsLessThanX,
    TimerIsMoreThanX,
    StarsExist,
    StarsNotExist,
    EnemiesExist,
    EnemiesNotExist,
    CoinsExist,
    CoinsNotExist,
    XPlayersRemaining,
    LessThanXPlayersRemaining,
    MoreThanXPlayersRemaining,
}

enum TriggerTarget {
    Everyone,
    Any,
    OneRandom,
    Randoms,
    Conditioner,
    ConditionerTeam,
    NonConditioner,
