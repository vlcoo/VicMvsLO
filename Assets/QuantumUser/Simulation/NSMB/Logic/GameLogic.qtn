#pragma max_players 10

global {
	GameRules Rules;	
	GameState GameState;
	int StartFrame;
	int TotalGamesPlayed;
	ushort GameStartFrames;
	ushort PlayerLoadFrames;

	[AllocateOnComponentAdded] dictionary<PlayerRef, EntityRef> PlayerDatas;
	array<PlayerInformation>[10] PlayerInfo;
	byte RealPlayers;
	byte TotalMarios;

	int WinningTeam;
	bool HasWinner;
}

struct PlayerInformation {
	PlayerRef PlayerRef;
	QString<48> Nickname;
	QString<16> NicknameColor;
	byte Team;
	byte Character;
	bool Disconnected;
	bool Disqualified;
}

struct GameRules {
	asset_ref<Map> Stage;

	int StarsToWin;
	int CoinsForPowerup;
	int Lives;
	int TimerSeconds;
	bool TeamsEnabled;
	bool CustomPowerupsEnabled;
	bool DrawOnTimeUp;
	int Laps;
	list<MatchConditionerTrigger> Triggers;
	list<int> Poggies;
}

enum GameState : Byte {
    PreGameRoom,
    WaitingForPlayers,
    Starting,
    Playing,
    Ended
}

struct MatchConditionerTrigger {
    TriggerCondition Condition;
    TriggerTarget ConditionTarget;
    TriggerAction Action;
    TriggerTarget ActionTarget;
    TriggerConstraint Constraint;
    bool ConstraintNegated;
    TriggerTarget ConstraintTarget;
}

enum TriggerCondition {
    GotStar,
    GotCoin,
    // ...
}

enum TriggerAction {
    GiveStar,
    GiveCoin,
    Kill,
    // ...
}

enum TriggerConstraint {
    Always,
    IsMoving,
    IsAirborne,
    // ...
}

enum TriggerTarget {
    All,
    Random,
    Self,
    Host,
    Winning,
    Losing,
    // ...
}

signal OnLoadingComplete();
signal OnGameStarting();
signal OnGameEnding(int winningTeam, bool hasWinner);
signal OnReturnToRoom();

synced event GameStateChanged {
	Frame Frame;
	GameState NewState;
}

synced event PlayerAdded {
	Frame Frame;
	PlayerRef Player;
}

synced event PlayerRemoved {
	Frame Frame;
	PlayerRef Player;
}

event PlayerDataChanged {
	nothashed Frame Frame;
	PlayerRef Player;
}

event StartingCountdownChanged {
	nothashed Frame Frame;
	bool IsGameStarting;
}

event CountdownTick {
	nothashed Frame Frame;
	int SecondsRemaining;
}

synced event HostChanged {
	Frame Frame;
	PlayerRef NewHost;
}

synced event RulesChanged {
	Frame Frame;
	bool LevelChanged;
}

synced event PlayerLoaded {
	Frame Frame;
	PlayerRef Player;
}

synced event RecordingStarted {
	Frame Frame;
}

synced event GameStarted {
	Frame Frame;
}

synced event GameEnded {
	Frame Frame;
	int WinningTeam;
	bool HasWinner;
}

event StartGameEndFade {
	nothashed Frame Frame;
}