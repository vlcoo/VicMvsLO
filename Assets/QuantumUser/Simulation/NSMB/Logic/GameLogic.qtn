#define MaxPlayers 10
#pragma max_players MaxPlayers

global {
	GameRules Rules;	
	GameState GameState;
	int StartFrame;
	int TotalGamesPlayed;
	ushort GameStartFrames;
	ushort PlayerLoadFrames;
	ushort AutomaticStageRefreshInterval;
	ushort AutomaticStageRefreshTimer;
//    ushort LoopingSecondsTimer;

	array<PlayerInformation>[MaxPlayers] PlayerInfo;
	byte RealPlayers;
	byte TotalMarios;

	int WinningTeam;
	bool HasWinner;
}

struct PlayerInformation {
	PlayerRef PlayerRef;
	QString<48> Nickname;
	QStringUtf8<48> NicknameColor;
	byte Team;
	byte Character;
	bool Disconnected;
	bool Disqualified;
}

struct GameRules {
	AssetRef<Map> Stage;
	AssetRef<GamemodeAsset> Gamemode;
	QStringUtf8<402> Description;

	int StarsToWin;
	int CoinsForPowerup;
	int Lives;
	int TimerSeconds;
	bool TeamsEnabled;
	bool CustomPowerupsEnabled;
	bool DrawOnTimeUp;
	bool ScoreEnabled;
	int Laps;
	list<MatchConditionerTrigger> Triggers;
	byte SpecialsCount;
	
	bool SNoReserve;
    bool SNoDroppedStars;
    bool SInstantDeath;
    bool SNoDefrost;
    bool SNoCollisions;
    bool SNoIframes;
    bool SHideSeek;
    bool SNoEnemies;
    bool SNoBahs;
    bool SPitWrap;
    bool SAllBricks;
    bool SNoLooping;
    bool SNoCoins;
    bool SNoPowerups;
    bool SShowCoinCount;
    
    bool PMushroom;
    bool PFireFlower;
    bool PIceFlower;
    bool PPropellerMushroom;
    bool PBlueShell;
    bool PHammerSuit;
    bool PMiniMushroom;
    bool PMegaMushroom;
    bool PStarman;
    
    bool HStars;
    bool HPlayers;
    bool HHost;
    bool HIceCubes;
    int HTeamTarget;
    bool HStarCount;
    bool HLifeCount;
    bool HLapCount;
    bool HCoinCount;
    bool HNicknames;
}

enum GameState : Byte {
    PreGameRoom,
    WaitingForPlayers,
    Starting,
    Playing,
    Ended
}

struct MatchConditionerTrigger {
    TriggerCondition Condition;
    QString<64> ConditionParameter;
    TriggerTarget ConditionTarget;
    TriggerAction Action;
    QString<64> ActionParameter;
    TriggerTarget ActionTarget;
    TriggerConstraint Constraint;
    QString<64> ConstraintParameter;
    TriggerTarget ConstraintTarget;
    byte DelaySeconds;      // 0-60
    byte RepeatCount;       // 1-100
    byte Chance;            // 1-100 (percent)
}

enum TriggerCondition {
    GotStar,
    GotCoin,
    Spawned,
    MatchStarted,
    GotCheckpoint,
    GotXPowerup,
    LostPowerup,
//    HitBlock,
    Stunned,
    Frozen,
//    Thawed,
//    TriggeredPowerup,
    Died,
    Jumped,
//    LookedXDirection,   // any, up, right, down, left
//    Ran,
    ReachedCoinLimit,
    Disqualified,
//    XSecondRemaining,   // 60, 10
//    SongBahd,
    ReachedZeroCoins,
    ReachedZeroStars,
//    GotStarcoin,
//    EnteredPipe,
//    GrabbedSomething,
    FinishedLap,
    EveryXSeconds, // 1, 5, 10, 15, 30, 60
    StunnedSomeone, // bump, knockback, hardknockback
    FrozeSomeone,
    HarmedSomeone,
    KilledSomeone,
    ReachedZeroScore,
//    TouchedGround,
//    StoppedMoving,
    KilledEnemy,
}

enum TriggerAction {
    GiveStar,
    GiveCoin,
    Kill,
    RemoveStar,
    RemoveCoin,
    GiveXPowerup,   // random, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
    GiveLife,
    Win,
    DrawMatch,
    Disqualify,
    Stun,    // bump, knockback, hardknockback
//    Dive,
//    Launch,
    Freeze,
    Harm,
    SpawnXPowerup,   // random, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
    SpawnXEnemy,    // random, goomba, Gkoopa, Rkoopa, Bkoopa, bulletbill, boo, spiny, bobomb
    RespawnLevel,
//    RandomTeleport,
    RemoveReserve,
    GiveXReserve,   // random, mushroom, fire, ice, propeller, shell, hammer, starman, mega, mini
    GiveIFrames,
    SpawnLooseCoin,
    SpawnLooseStar,
    ZeroCoins,
    ZeroStars,
    MaxCoins,
//    SpawnStar,
//    BecomeXTeam,    // random, A, B, C, D, E
    AddXToScore,    // 1, 10, 100
    SubtractXFromScore, // 1, 10, 100
    ZeroScore,
    ExplodeLevel,
    PlayJingle,     // Positive, Negative, Neutral 1, Neutral 2
}

enum TriggerConstraint {
    Always,
    IsMoving,
    IsStationary,
    IsAirborne,
    IsGrounded,
    IsXPowerup,   // small, mushroom, fire, ice, propeller, shell, hammer, mega, mini
    IsNotXPowerup,   // small, mushroom, fire, ice, propeller, shell, hammer, mega, mini
    IsStarman,
    IsNotStarman,
    IsFrozen,
    IsNotFrozen,
    IsUnderwater,
    IsNotUnderwater,
    HasXCoins,  // any X in valid range vvv
    HasXStars,
    HasXLives,
    HasXScore,
    HasLessThanXCoins,
    HasLessThanXStars,
    HasLessThanXLives,
    HasLessThanXScore,
    HasMoreThanXCoins,
    HasMoreThanXStars,
    HasMoreThanXLives,
    HasMoreThanXScore,
    TimerIsLessThanX,
    TimerIsMoreThanX,
    StarsExist,
    StarsNotExist,
    EnemiesExist,
    EnemiesNotExist,
    CoinsExist,
    CoinsNotExist,
    XPlayersRemaining,
    LessThanXPlayersRemaining,
    MoreThanXPlayersRemaining,
}

enum TriggerTarget {
    Everyone,
    Any,
    OneRandom,
    Randoms,
    Conditioner,
    ConditionerTeam,
    NonConditioner,
    NonConditionerTeam,
    Actioner,
    ActionerTeam,
    NonActioner,
    NonActionerTeam,
    Host,
    NonHost,
    TeamA,
    NonTeamA,
    TeamB,
    NonTeamB,
    TeamC,
    NonTeamC,
    TeamD,
    NonTeamD,
    TeamE,
    NonTeamE,
//    FirstPlace,
//    NonFirstPlace,
//    LastPlace,
//    NonLastPlace,
    CheckIndividually,
}

enum TriggerParameter {
    Random,
    Mushroom,
    Fire,
    Ice,
    Propeller,
    Shell,
    Hammer,
    Starman,
    Mega,
    Mini,
    Goomba,
    GreenKoopa,
