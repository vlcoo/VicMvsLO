component Freezable {
	FPVector2 IceBlockSize;
	byte AutoBreakFrames;
	byte AutoBreakGrabAdditionalFrames;
	bool AutoBreakWhileHeld;
	FPVector2 Offset;
	bool IsCarryable;
	bool IsFlying;

	[ExcludeFromPrototype] EntityRef FrozenCubeEntity;
}

signal OnEntityFreeze(EntityRef entity, EntityRef iceBlock, EntityRef attacker);

event EntityFrozen {
	EntityRef Entity;
	EntityRef IceBlock;
}

event EntityThawed {
	EntityRef Entity;
	EntityRef IceBlock;
}